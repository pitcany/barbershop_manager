{
  "identity": {
    "name": "Barbershop Autopilot",
    "persona": "The Reliable Manager",
    "tone": "Professional, Masculine, Trustworthy, Efficient",
    "aesthetic": "Old Money Tech / Modern Barbershop",
    "theme_mode": "dark"
  },
  "typography": {
    "font_family": {
      "heading": "Playfair Display, serif",
      "body": "Inter, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "google_fonts_import": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@400;600;700&display=swap",
    "usage": {
      "h1": "font-heading font-bold text-4xl tracking-tight",
      "h2": "font-heading font-semibold text-3xl tracking-tight",
      "h3": "font-heading font-semibold text-2xl",
      "body": "font-body text-base leading-relaxed text-muted-foreground",
      "label": "font-mono text-xs uppercase tracking-wider text-muted-foreground",
      "numbers": "font-mono font-medium"
    }
  },
  "colors": {
    "palette": {
      "background": "#09090b",
      "foreground": "#fafafa",
      "card": "#18181b",
      "card_foreground": "#fafafa",
      "popover": "#09090b",
      "popover_foreground": "#fafafa",
      "primary": "#D4AF37",
      "primary_foreground": "#000000",
      "secondary": "#27272a",
      "secondary_foreground": "#fafafa",
      "muted": "#27272a",
      "muted_foreground": "#a1a1aa",
      "accent": "#27272a",
      "accent_foreground": "#fafafa",
      "destructive": "#7f1d1d",
      "destructive_foreground": "#fafafa",
      "border": "#27272a",
      "input": "#27272a",
      "ring": "#D4AF37"
    },
    "semantic": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    }
  },
  "layout": {
    "spacing": {
      "container_padding": "p-6 md:p-8 lg:p-12",
      "section_gap": "gap-8",
      "component_gap": "gap-4"
    },
    "grid_system": {
      "dashboard": "grid grid-cols-1 md:grid-cols-4 gap-6",
      "card_grid": "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    },
    "border_radius": {
      "default": "rounded-md",
      "card": "rounded-lg",
      "button": "rounded-md"
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-primary text-primary-foreground hover:bg-primary/90 shadow-sm font-medium transition-all active:scale-95",
      "secondary": "bg-secondary text-secondary-foreground hover:bg-secondary/80 shadow-sm font-medium transition-all active:scale-95",
      "ghost": "hover:bg-accent hover:text-accent-foreground transition-all active:scale-95",
      "outline": "border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-all active:scale-95"
    },
    "cards": {
      "style": "bg-card text-card-foreground border border-border shadow-none",
      "hover": "hover:border-primary/50 transition-colors duration-300"
    },
    "inputs": {
      "style": "bg-input/50 border-input focus:ring-1 focus:ring-primary focus:border-primary transition-all"
    },
    "sidebar": {
      "style": "bg-card border-r border-border h-screen sticky top-0",
      "link_active": "bg-primary/10 text-primary border-r-2 border-primary",
      "link_inactive": "text-muted-foreground hover:text-foreground hover:bg-accent/50"
    }
  },
  "visual_enhancers": {
    "glassmorphism": "backdrop-blur-md bg-background/80 border-b border-border/50",
    "gradients": "None. Use solid colors and subtle borders.",
    "shadows": "shadow-sm",
    "textures": "Use subtle noise texture on the main background if possible, or keep it clean matte black."
  },
